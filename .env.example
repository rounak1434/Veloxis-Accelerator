# Veloxis Production Environment Variables (.env.example)

# Server & Network Configuration
PORT=6789
NODE_ENV=production
ALLOWED_ORIGINS=https://veloxis.dev,https://app.veloxis.dev

# Persistence & Storage
VELOXIS_DATA_DIR=./data
MAX_CONCURRENT_TASKS=4
MAX_SEGMENTS_PER_TASK=32

# Stripe Billing (Live Mode)
STRIPE_SECRET_KEY=sk_live_your_actual_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_actual_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Telemetry & Monitoring (Anonymous Crash Diagnostics Only)
SENTRY_DSN=https://your_sentry_or_glitchtip_dsn_here@sentry.veloxis.dev/1
LOG_LEVEL=info
