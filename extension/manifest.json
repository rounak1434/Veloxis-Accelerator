{
  "manifest_version": 3,
  "name": "Veloxis Accelerator Integration",
  "version": "1.0.0",
  "description": "Smart browser integration and media stream grabber for Veloxis Accelerator.",
  "permissions": [
    "downloads",
    "activeTab",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "http://localhost:6789/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["media-grabber.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Veloxis Accelerator Status"
  }
}
